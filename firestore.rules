rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admin-SDK-only: googleRefreshToken and other server-managed fields must
    // never be client-writable. Client writes are blocked entirely; all
    // updates go through Cloud Functions using the Admin SDK (which bypasses
    // these rules).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /lists/{listId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /reminders/{reminderId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /dailyNotes/{docId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /conversations/{conversationId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);

      match /messages/{messageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId);
        // Messages are written by the chat Cloud Function via the Admin SDK.
        allow write: if false;
      }
    }

    match /caroleProfile/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
